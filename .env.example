# ─── Core ─────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for payment callbacks, emails, sitemap.
APP_URL=http://localhost:3000
# Local dev uses the embedded PostgreSQL started by `npm run db:start` (port 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/boostsphere?schema=public
# 32-byte key, base64. Encrypts 2FA secrets at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ─── Payments ─────────────────────────────────────────────────────────
# Comma-separated list of enabled providers, in display order: paystack,flutterwave,stripe,wallet,sandbox
PAYMENT_PROVIDERS=paystack,wallet
# Development-only simulated provider. Refused at runtime when NODE_ENV=production.
PAYMENT_SANDBOX_ENABLED=false

# Paystack — https://dashboard.paystack.com/#/settings/developers (use sk_test_ keys for testing)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave — https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
# Must match the "Secret hash" configured on the Flutterwave webhook settings page.
FLUTTERWAVE_WEBHOOK_HASH=

# Stripe — only where your business entity is supported by Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ────────────────────────────────────────────────────────────
# If RESEND_API_KEY is empty, emails are written to the email_outbox table and the server log only.
EMAIL_FROM="BoostSphere <no-reply@example.com>"
RESEND_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────
# Private file storage directory (local driver). Never place this inside /public.
STORAGE_DIR=./storage/private
# Bearer token for POST /api/v1/cron/maintenance (generate a long random value).
CRON_SECRET=

# ─── Development / testing only ───────────────────────────────────────
# Password for the demo accounts created by `npm run db:seed` (never used in production).
SEED_PASSWORD=
# Separate database for `npm test` (default: boostsphere_test on the embedded server).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/boostsphere_test?schema=public

# ─── Private object storage (production) ─────────────────────────────
# local (default, dev/single server) | s3 (any S3-compatible private bucket: AWS S3, Cloudflare R2, Spaces, MinIO)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
